node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.env
.env.*
!.env.example

# Hadith bulk data is ~73 MB of generated JSON. It is regenerated verbatim by
# `npm run data:hadith` and rebuilt in CI on every deploy, so it does not belong
# in git history. The index, which the app needs to render the collection list,
# IS committed.
public/data/hadith/*/
!public/data/hadith/index.json

# The Quran text, dua data and search indexes ARE committed on purpose:
# the text of the muṣḥaf should be version-controlled and diffable, so that any
# change to a single letter shows up in review.

# --- Capacitor / Android ---
# The android/ project itself IS committed so the APK is reproducible, but
# build output, the copied web bundle and machine-local paths are not.
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/
android/local.properties
*.apk
*.aab
*.keystore
!android/gradle/wrapper/gradle-wrapper.jar
logo-preview.png

# Signing material. Losing the upload key means losing the ability to update the
# app on Play; committing it means anyone can publish as you.
*.jks
keystore.properties
android/keystore.properties
