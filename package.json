  "private": false,
  "description": "Sabeel — Quran, Hadith, Prayer, Dua. Free forever, no ads, no tracking, offline-first.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:quran": "node scripts/fetch-quran.mjs",
    "data:hadith": "node scripts/fetch-hadith.mjs",
    "data:dua": "node scripts/fetch-dua.mjs",
    "data:index": "node scripts/build-search-index.mjs",
    "data:verify": "node scripts/verify-integrity.mjs",
    "data:all": "npm run data:quran && npm run data:dua && npm run data:hadith && npm run data:index && npm run data:fonts && npm run data:icons && npm run data:verify",
