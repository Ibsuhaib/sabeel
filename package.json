    "data:icons": "node scripts/make-icons.mjs",
    "test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "adhan": "^4.4.3",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
